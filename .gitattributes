# Normalize line endings in the repository and in the working copy (D-41).
# Takes precedence over each machine's core.autocrlf.
* text=auto eol=lf

# Windows scripts need CRLF to run
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Hidroweb CSVs are golden-file inputs: keep their bytes exactly
# as downloaded (no line-ending conversion)
*.csv -text

# Binaries
*.pdf  binary
*.png  binary
*.jpg  binary
*.jpeg binary
*.zip  binary
*.xlsx binary

# Spec Kit scaffolding does not count toward the repository's language statistics
.specify/** linguist-vendored
